{
  "name": "@pplx-unofficial/sdk",
  "version": "1.0.0",
  "description": "Unofficial TypeScript SDK for Perplexity AI - SSE Streaming, REST API, OAuth Connectors",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./stream": {
      "import": {
        "types": "./dist/pplx-client.d.mts",
        "default": "./dist/pplx-client.mjs"
      },
      "require": {
        "types": "./dist/pplx-client.d.ts",
        "default": "./dist/pplx-client.js"
      }
    },
    "./rest": {
      "import": {
        "types": "./dist/pplx-rest-client.d.mts",
        "default": "./dist/pplx-rest-client.mjs"
      },
      "require": {
        "types": "./dist/pplx-rest-client.d.ts",
        "default": "./dist/pplx-rest-client.js"
      }
    },
    "./connectors": {
      "import": {
        "types": "./dist/pplx-connectors-client.d.mts",
        "default": "./dist/pplx-connectors-client.mjs"
      },
      "require": {
        "types": "./dist/pplx-connectors-client.d.ts",
        "default": "./dist/pplx-connectors-client.js"
      }
    },
    "./service-worker": {
      "import": {
        "types": "./dist/pplx-service-worker-client.d.mts",
        "default": "./dist/pplx-service-worker-client.mjs"
      },
      "require": {
        "types": "./dist/pplx-service-worker-client.d.ts",
        "default": "./dist/pplx-service-worker-client.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/pplx-client.ts src/pplx-rest-client.ts src/pplx-connectors-client.ts src/pplx-service-worker-client.ts --format cjs,esm --clean && tsc --emitDeclarationOnly --declarationMap false && node scripts/finalize-declarations.mjs",
    "dev": "tsup src/index.ts --watch",
    "test": "node --test scripts/*.test.mjs",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "perplexity",
    "perplexity-ai",
    "ai-search",
    "sse",
    "streaming",
    "rest-api",
    "oauth",
    "typescript",
    "sdk",
    "unofficial"
  ],
  "author": {
    "name": "pv-udpv",
    "url": "https://github.com/pv-udpv"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pv-udpv/pplx-unofficial-sdk.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsup": "^8.0.1",
    "typescript": "^7.0.2"
  }
}
